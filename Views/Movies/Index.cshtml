@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "Movies";
}

<h1>My Favorite Movies</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<form asp-controller="Movies" asp-action="Index" method="get" class="movie-filter">
    <select name="movieGenre" asp-items="Model.Genres">
        <option value="">All genres</option>
    </select>
    <input type="text" name="searchString" placeholder="Search title" />
    <input type="submit" value="Filter" />
</form>

<div class="movie-grid">
    @foreach (var item in Model.Movies!)
    {
        <div class="movie-card">
            <a asp-action="Details" asp-route-id="@item.Id">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Title" class="movie-poster" />
                }
                else
                {
                    <div class="movie-poster movie-poster-empty">No image</div>
                }
            </a>
            <div class="movie-info">
                <h5>@item.Title</h5>
                <p class="movie-meta">@item.Genre &middot; @item.Rating</p>
                <p class="movie-price">@item.Price.ToString("C")</p>
                <div class="movie-actions">
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </div>
            </div>
        </div>
    }
</div>